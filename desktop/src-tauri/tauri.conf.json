{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merge Forge",
  "version": "1.0.0",
  "identifier": "app.mergeforge.desktop",
  "build": {
    "beforeDevCommand": "node prepare.mjs && node serve.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node prepare.mjs --production",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Merge Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
